~/digital-detective-8410/terminal-practice

# 1. Creating file and writing initial content (overwrite with >)
$ echo "Initial file content" > notes.txt
$ cat notes.txt
Initial file content

# 2. Appending content without overwriting (append with >>)
$ echo "Appended second line" >> notes.txt
$ cat notes.txt
Initial file content
Appended second line

# 3. Copying vs moving
$ cp notes.txt copied_notes.txt
$ mv copied_notes.txt moved_notes.txt

